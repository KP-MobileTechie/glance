# Optional cloud sync and theme gallery (Supabase).
# Leave unset to run Glance fully local-first with no account.
#
# 1. Create a project at supabase.com
# 2. Enable GitHub OAuth under Authentication > Providers
# 3. Run supabase/migrations/0001_init.sql in the SQL editor
# 4. Copy this file to .env.local and fill in the values below
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
